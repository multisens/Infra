            "appIcon": {
              "type": "string",
              "maxLength": 16384,
              "pattern": "^[[:space:]]*(<\\?xml[^>]*\\?>[[:space:]]*)?<svg[[:space:]>]"
            },
            "bannerIcon": {
              "type": "string",
              "maxLength": 16384,
              "pattern": "^[[:space:]]*(<\\?xml[^>]*\\?>[[:space:]]*)?<svg[[:space:]>]"
            },
            "fallbackMediaURLs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^[:space:]]+$"
