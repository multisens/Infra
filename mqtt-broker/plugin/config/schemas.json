{
  "sensor/room1/temperature": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "value": {
        "type": "number",
        "minimum": 0,
        "maximum": 30,
        "description": "Temperature value in Celsius"
      },
      "timestamp": {
        "type": "string",
        "minLength": 1,
        "description": "Timestamp of the reading"
      },
      "unit": {
        "type": "string",
        "enum": [
          "celsius",
          "fahrenheit"
        ],
        "description": "Temperature unit"
      }
    },
    "required": [
      "value"
    ],
    "additionalProperties": false
  },
  "sensor/room2/humidity": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "value": {
        "type": "number",
        "minimum": 0,
        "maximum": 200,
        "description": "Humidity percentage"
      },
      "unit": {
        "type": "string",
        "enum": [
          "C",
          "F"
        ],
        "description": "Temperature unit: Celsius or Fahrenheit"
      },
      "sensor_id": {
        "type": "string",
        "pattern": "^[A-Z]{3}-[0-9]{4}$",
        "description": "Sensor ID in format XXX-0000"
      }
    },
    "required": [
      "value",
      "unit"
    ],
    "additionalProperties": false
  },
  "sensor/comprehensive/test": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "string_field": {
        "type": "string",
        "minLength": 3,
        "maxLength": 20,
        "pattern": "^[a-z]+$",
        "description": "String with length and pattern constraints"
      },
      "number_field": {
        "type": "number",
        "minimum": 10,
        "maximum": 100,
        "multipleOf": 5,
        "description": "Number that must be multiple of 5 between 10 and 100"
      },
      "integer_field": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "exclusiveMaximum": 50,
        "description": "Integer between 1 and 49"
      },
      "boolean_field": {
        "type": "boolean",
        "description": "Boolean value"
      },
      "enum_field": {
        "type": "string",
        "enum": [
          "option1",
          "option2",
          "option3"
        ],
        "description": "Must be one of the allowed values"
      },
      "const_field": {
        "type": "string",
        "const": "fixed_value",
        "description": "Must be exactly this value"
      },
      "array_field": {
        "type": "array",
        "minItems": 2,
        "maxItems": 5,
        "uniqueItems": true,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "description": "Array of 2-5 unique numbers between 0 and 10"
      },
      "nested_object": {
        "type": "object",
        "properties": {
          "nested_string": {
            "type": "string",
            "minLength": 1
          },
          "nested_number": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "nested_string"
        ],
        "additionalProperties": false,
        "minProperties": 1,
        "maxProperties": 2,
        "description": "Nested object with constraints"
      }
    },
    "required": [
      "string_field",
      "number_field",
      "integer_field",
      "boolean_field",
      "enum_field",
      "const_field"
    ],
    "additionalProperties": false
  },
  "aop/currentUser": {
    "type": "string",
    "maxLength": 64
  },
  "aop/removedUser": {
    "type": "string",
    "minLength": 1,
    "maxLength": 64,
    "description": "O id do perfil que o telespectador removeu no gestor de perfis do AoP, NAO retido, publicado depois de o perfil, a visibilidade, os atributos de emissora e o arquivo do avatar serem descartados. Se era o perfil corrente, o AoP publica antes aop/currentUser vazio (retido), que passa ao perfil escolhido no seletor. Publicador: o AoP."
  },
  "aop/currentService": {
    "type": "string",
    "maxLength": 256
  },
  "aop/services": {
    "type": "array",
    "uniqueItems": true,
    "items": {
      "type": "object",
      "properties": {
        "serviceContextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "O globalServiceId do BAM (Tabela 6), que e o serviceContextId das rotas (C.3.5)."
        }
      },
      "required": [
        "serviceContextId"
      ],
      "additionalProperties": false
    },
    "description": "Os servicos anunciados na LLS, um por BAM das BAMT recebidas, sem repeticao, RETIDO; lista vazia = nenhum. O mesmo conteudo de services:announced no Redis, gravado antes da publicacao. Sem o serviceId inteiro da C.6.3.1, que o BAM nao traz. Publicador: aop-transport-layer-metadata-lls, no processo do AoP, a cada BAMT recebida ou retirada e na partida."
  },
  "aop/display/layers/rxgui": {
    "type": "string",
    "maxLength": 256
  },
  "aop/display/layers/graphics": {
    "type": "string",
    "maxLength": 1024
  },
  "aop/display/layers/video/url": {
    "type": "string",
    "maxLength": 1024
  },
  "aop/display/layers/video/size": {
    "type": "object",
    "properties": {
      "top": {
        "type": "string",
        "maxLength": 16
      },
      "left": {
        "type": "string",
        "maxLength": 16
      },
      "width": {
        "type": "string",
        "maxLength": 16
      },
      "height": {
        "type": "string",
        "maxLength": 16
      }
    },
    "required": [
      "top",
      "left",
      "width",
      "height"
    ],
    "additionalProperties": false
  },
  "video/event": {
    "type": "object"
  },
  "tlm/lls/+/slt": {
    "description": "SLT of the RF channel {bsid} (ATSC A/331, 6.3; ABNT NBR 25602, 8.1), in JSON. Retained; the empty message clears it. Publisher: aop-cc.",
    "type": "object",
    "properties": {
      "bsid": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "minItems": 1
      },
      "bandwidth": {
        "enum": [
          6,
          7,
          8
        ]
      },
      "Service": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "serviceId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "globalServiceId": {
              "type": "string",
              "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:[^[:space:]]+$"
            },
            "sltSvcSeqNum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "majorChannelNo": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            },
            "minorChannelNo": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            },
            "serviceCategory": {
              "enum": [
                30,
                31,
                32
              ]
            },
            "shortServiceName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 7
            },
            "hidden": {
              "type": "boolean"
            },
            "broadbandAccessRequired": {
              "type": "boolean"
            },
            "configuration": {
              "enum": [
                "Broadcast",
                "Broadband"
              ]
            },
            "mainAvOverTheAir": {
              "type": "boolean"
            },
            "receptionQuality": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "SvcInetUrl": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "urlType": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^[:space:]]+$"
                  }
                },
                "required": [
                  "urlType",
                  "value"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "serviceId",
            "globalServiceId",
            "sltSvcSeqNum",
            "serviceCategory",
            "configuration",
            "mainAvOverTheAir",
            "receptionQuality"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      }
    },
    "required": [
      "bsid",
      "bandwidth",
      "Service"
    ],
    "additionalProperties": false
  },
  "tlm/lls/+/bamt": {
    "description": "BAMT of the RF channel {bsid} (ABNT NBR 25602, 8.2; ABNT NBR 25608, 8.4.4), in JSON. Retained; the empty message clears it. Publisher: aop-cc.",
    "type": "object",
    "properties": {
      "groupingType": {
        "enum": [
          "optionalGrouping",
          "mandatoryGrouping",
          "noGrouping"
        ]
      },
