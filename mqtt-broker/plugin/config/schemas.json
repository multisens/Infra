                "STORED_AUTOSTART",
                "STORED_PRESENT",
                "DESTROY",
                "KILL",
                "STORED_REMOVE"
              ]
            },
            "appIcon": {
              "type": "string",
              "maxLength": 16384,
              "pattern": "^[[:space:]]*(<\\?xml[^>]*\\?>[[:space:]]*)?<svg[[:space:]>]"
            }
          },
          "required": [
            "appContextId",
            "appType",
            "appId",
            "appName"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      }
    },
    "required": [
      "EntryPackage"
    ],
    "additionalProperties": false
  },
