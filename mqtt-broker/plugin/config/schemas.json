            "appVersion": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "appName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "appDescription": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "backgroundColor": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "foregroundColor": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "additionalServices": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "minItems": 1
