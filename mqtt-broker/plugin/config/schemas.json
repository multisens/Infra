            "shortServiceName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 7
            },
            "hidden": {
              "type": "boolean"
            },
            "broadbandAccessRequired": {
              "type": "boolean"
            },
            "configuration": {
              "enum": [
                "Broadcast",
                "Broadband"
              ]
            },
            "mainAvOverTheAir": {
              "type": "boolean"
            },
            "receptionQuality": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "SvcInetUrl": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "urlType": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^[:space:]]+$"
                  }
                },
                "required": [
                  "urlType",
                  "value"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "serviceId",
            "globalServiceId",
            "sltSvcSeqNum",
            "serviceCategory",
            "configuration",
            "mainAvOverTheAir",
            "receptionQuality"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      }
    },
    "required": [
      "bsid",
      "bandwidth",
      "Service"
    ],
    "additionalProperties": false
  },
