              "minItems": 1
            }
          },
          "required": [
            "globalServiceId",
            "appVersion",
            "appName",
            "backgroundColor",
            "foregroundColor",
            "appIcon",
            "bannerIcon"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      }
    },
    "required": [
      "BAM"
    ],
    "additionalProperties": false
  },
