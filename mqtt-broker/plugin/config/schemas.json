            "majorChannelNo": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            },
            "minorChannelNo": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            },
            "serviceCategory": {
              "enum": [
                30,
                31,
                32
              ]
