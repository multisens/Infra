        "enum": [
          6,
          7,
          8
        ]
      },
      "Service": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "serviceId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "globalServiceId": {
              "type": "string",
              "pattern": "^urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:[^[:space:]]+$"
            },
            "sltSvcSeqNum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
