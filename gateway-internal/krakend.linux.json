{
  "$schema": "https://www.krakend.io/schema/v2.7/krakend.json",
  "version": 3,
  "name": "GingaDistrib API Gateway (Internal)",
  "port": 8080,
  "allow_insecure_connections": false,
  "extra_config": {
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "allow_headers": ["Content-Type", "Authorization", "Accept-Version"],
      "expose_headers": ["Content-Length"],
      "max_age": "12h",
      "allow_credentials": false
    }
  },
  "endpoints": [
    {
      "endpoint": "/health",
      "method": "GET",
      "input_headers": [
        "Accept-Version"
      ],
      "backend": [
        {
          "url_pattern": "/health",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/authorize",
      "method": "GET",
      "input_headers": [
        "Accept-Version"
      ],
      "input_query_strings": [
        "clientid",
        "display-name",
        "pm",
        "key"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/authorize",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/token",
      "method": "GET",
      "input_headers": [
        "Authorization",
        "Accept-Version"
      ],
      "input_query_strings": [
        "clientid",
        "challenge-response",
        "refresh-token"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/token",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/current-service",
      "method": "GET",
      "input_headers": [
        "Authorization",
        "Accept-Version"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/current-service",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/current-service/users",
      "method": "POST",
      "input_headers": [
        "Authorization",
        "Accept-Version",
        "Content-Type"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/current-service/users",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/current-service/users/current-user",
      "method": "GET",
      "input_headers": [
        "Authorization",
        "Accept-Version"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/current-service/users/current-user",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/current-service/users/current-user",
      "method": "POST",
      "input_headers": [
        "Authorization",
        "Accept-Version",
        "Content-Type"
      ],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/tv3/current-service/users/current-user",
          "host": [
            "http://ccws:44652"
          ],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/tv3/users",
      "method": "POST",
      "input_headers": [
        "Authorization",
        "Accept-Version",
        "Content-Type"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/users",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/current-service/users/files",
      "method": "GET",
      "input_headers": [
        "Authorization",
        "Accept-Version"
      ],
      "input_query_strings": [
        "path"
      ],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/tv3/current-service/users/files",
          "host": [
            "http://ccws:44652"
          ],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/tv3/current-service/users/{userid}",
      "method": "GET",
      "input_headers": [
        "Authorization",
        "Accept-Version"
      ],
      "input_query_strings": [
        "attribute"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/current-service/users/{userid}",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/{serviceContextId}/users",
      "method": "POST",
      "input_headers": [
        "Authorization",
        "Accept-Version",
        "Content-Type"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/{serviceContextId}/users",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/{serviceContextId}/users/{userid}/broadcaster-attrs",
      "method": "GET",
      "input_headers": [
        "Authorization",
        "Accept-Version"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/{serviceContextId}/users/{userid}/broadcaster-attrs",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/{serviceContextId}/users/{userid}/broadcaster-attrs",
      "method": "PUT",
      "input_headers": [
        "Authorization",
        "Accept-Version",
        "Content-Type"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/{serviceContextId}/users/{userid}/broadcaster-attrs",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/current-service/apps/{appid}/files",
      "method": "GET",
      "input_headers": [
        "Authorization",
        "Accept-Version",
        "Range"
      ],
      "input_query_strings": [
        "path"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/current-service/apps/{appid}/files",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/remote-device",
      "method": "POST",
      "input_headers": [
        "Authorization",
        "Accept-Version",
        "Content-Type"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/remote-device",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/remote-device/{handle}",
      "method": "DELETE",
      "input_headers": [
        "Authorization",
        "Accept-Version"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/remote-device/{handle}",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/remote-device/devices/{classId}",
      "method": "GET",
      "input_headers": [
        "Authorization",
        "Accept-Version"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/remote-device/devices/{classId}",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/remote-device/device/{handle}",
      "method": "GET",
      "input_headers": [
        "Authorization",
        "Accept-Version"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/remote-device/device/{handle}",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/remote-device/device/{handle}",
      "method": "DELETE",
      "input_headers": [
        "Authorization",
        "Accept-Version"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/remote-device/device/{handle}",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/sensory-effect-renderers",
      "method": "GET",
      "input_headers": [
        "Authorization",
        "Accept-Version"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/sensory-effect-renderers",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/sensory-effect-renderers/{rendererId}",
      "method": "GET",
      "input_headers": [
        "Authorization",
        "Accept-Version"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/sensory-effect-renderers/{rendererId}",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    },
    {
      "endpoint": "/tv3/sensory-effect-renderers/{rendererId}",
      "method": "POST",
      "input_headers": [
        "Authorization",
        "Accept-Version",
        "Content-Type"
      ],
      "backend": [
        {
          "url_pattern": "/tv3/sensory-effect-renderers/{rendererId}",
          "host": [
            "http://ccws:44652"
          ]
        }
      ]
    }
  ]
}